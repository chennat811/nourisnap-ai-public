  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "update-local-ip": "node update-local-ip.js",
    "sb:link:dev": "supabase link --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.development | cut -d= -f2)",
    "sb:link:staging": "supabase link --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.staging | cut -d= -f2)",
    "sb:link:prod": "supabase link --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.production | cut -d= -f2)",
    "sb:db:push:dev": "supabase db push --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.development | cut -d= -f2)",
    "sb:db:push:staging": "supabase db push --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.staging | cut -d= -f2)",
    "sb:db:push:prod": "supabase db push --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.production | cut -d= -f2)",
    "sb:secrets:dev": "supabase secrets set --env-file .env.development --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.development | cut -d= -f2)",
    "sb:secrets:staging": "supabase secrets set --env-file .env.staging --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.staging | cut -d= -f2)",
    "sb:secrets:prod": "supabase secrets set --env-file .env.production --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.production | cut -d= -f2)",
    "sb:fn:deploy:dev": "supabase functions deploy openai --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.development | cut -d= -f2)",
    "sb:fn:deploy:staging": "supabase functions deploy openai --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.staging | cut -d= -f2)",
    "sb:fn:deploy:prod": "supabase functions deploy openai --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.production | cut -d= -f2)",
    "sb:fn:deploy:delete-user:dev": "supabase functions deploy delete-user --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.development | cut -d= -f2)",
    "sb:fn:deploy:delete-user:staging": "supabase functions deploy delete-user --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.staging | cut -d= -f2)",
    "sb:fn:deploy:delete-user:prod": "supabase functions deploy delete-user --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.production | cut -d= -f2)",
    "sb:fn:logs:dev": "supabase functions logs openai --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.development | cut -d= -f2)",
    "sb:fn:logs:staging": "supabase functions logs openai --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.staging | cut -d= -f2)",
    "sb:fn:logs:prod": "supabase functions logs openai --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.production | cut -d= -f2)",
    "sb:fn:logs:delete-user:dev": "supabase functions logs delete-user --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.development | cut -d= -f2)",
    "sb:fn:logs:delete-user:staging": "supabase functions logs delete-user --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.staging | cut -d= -f2)",
    "sb:fn:logs:delete-user:prod": "supabase functions logs delete-user --project-ref $(grep -E '^SUPABASE_PROJECT_REF=' .env.production | cut -d= -f2)"
